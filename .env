POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

SPRING_DATA_REDIS_HOST=master_redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATASOURCE_URL=jdbc:postgresql://master_postgres:5432/postgres
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_URL_SHORTENER_EVENT_TOPIC=url-shortener-event-topic
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1
SPRING_KAFKA_TOPIC_PARTITIONS=3
SPRING_KAFKA_PRODUCER_ACKS=all
SPRING_KAFKA_PRODUCER_DELIVERY_TIMEOUT=12000
SPRING_KAFKA_PRODUCER_LINGER=0
SPRING_KAFKA_PRODUCER_REQUEST_TIMEOUT=3000
SPRING_KAFKA_PRODUCER_IDEMPOTENCE=true
SPRING_KAFKA_PRODUCER_INFLIGHT_REQUESTS=5
SPRING_KAFKA_PRODUCER_PROPERTIES_RETRIES=3
SPRING_KAFKA_PRODUCER_PROPERTIES_COMPRESSION_TYPE=snappy
SPRING_KAFKA_PRODUCER_PROPERTIES_BATCH_SIZE=16384